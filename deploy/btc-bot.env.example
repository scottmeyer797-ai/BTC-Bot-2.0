# Copy to /etc/btc-bot.env and `chmod 600` it. Never commit the real file.
MODE=challenge
ACCOUNT_SIZE=100000
BOT_ENABLED=true
BLOFIN_API_KEY=
BLOFIN_API_SECRET=
BLOFIN_PASSPHRASE=
DISCORD_WEBHOOK_URL=
REPO_ROOT=/opt/btc-bot
STATE_DIR=/opt/btc-bot-state
CACHE_DIR=/opt/btc-bot/data/cache
PUSH_STATE=true
